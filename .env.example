# Antigravity Workspace Configuration
# Copy this file and configure your API keys

# Google Gemini API Key (Required)
# GOOGLE_API_KEY=AIzaSyBwwM0EXAMPLEKEY1234567890
# GEMINI_MODEL_NAME=gemini-2.5-flash

# Optional: OpenAI API Key for alternative LLM
# OPENAI_API_KEY=your_openai_key_here

# Optional: Model Configuration
# MODEL_NAME=gemini-2.5-flash

# --------------------------------------------------------------------
# Sandbox Configuration (optional)
# These settings control how code execution is sandboxed.

# Sandbox type to use for code execution.
# Supported values: "local" (default), "microsandbox", and "e2b" (future).
# SANDBOX_TYPE=local

# Maximum time (in seconds) each sandboxed execution is allowed to run.
# SANDBOX_TIMEOUT_SEC=30

# Maximum amount of output (in kilobytes) captured from sandboxed runs.
# SANDBOX_MAX_OUTPUT_KB=64

# Microsandbox runtime settings (used when SANDBOX_TYPE=microsandbox)

# Microsandbox server URL.
# MSB_SERVER_URL=http://127.0.0.1:5555

# Optional API key for Microsandbox server authentication.
# MSB_API_KEY=

# Microsandbox image for Python execution.
# MSB_IMAGE=microsandbox/python

# Resource hints for sandbox startup.
# MSB_CPU_LIMIT=1.0
# MSB_MEMORY_MB=512
# MSB_START_TIMEOUT_SEC=30

# Roam lobby used by the contact-page scheduler.
# Leave unset to use the default; set to an empty string to hide the embed
# (the contact form and phone number remain).
NEXT_PUBLIC_BOOKING_URL=https://ro.am/ronrose/meeting

# --------------------------------------------------------------------
# Quo (quo.com, formerly OpenPhone)
# Server-side only. Never prefix these with NEXT_PUBLIC_: that would inline
# the value into the browser bundle.

# Workspace API key, from Quo: Workspace Settings > API.
# Base URL is https://api.quo.com. Requests send "Authorization: <key>" with
# no Bearer prefix, plus "Quo-Api-Version: 2026-03-30".
# QUO_API_KEY=

# Webhook signing key returned when the webhook is created, e.g. whsec_...
# Store it exactly as Quo returns it: do not trim or re-wrap it.
# QUO_WEBHOOK_SECRET=

# --------------------------------------------------------------------
# CRM database (Postgres, e.g. Neon via the Vercel Marketplace)
# Apply the schema with: npm run migrate
# DATABASE_URL=

# --------------------------------------------------------------------
# Confirmation texts
# OFF by default. Setting this to "true" is necessary but not sufficient:
# a text is only sent when the lead also ticked the consent box AND Quo
# reports the A2P 10DLC registration as approved.
# SMS_CONFIRMATIONS_ENABLED=false

# --------------------------------------------------------------------
# Admin CRM at /admin/crm
# Generate the hash with: node scripts/hash-password.mjs
# ADMIN_PASSWORD_HASH=
# Random string, at least 32 characters: openssl rand -base64 32
# ADMIN_SESSION_SECRET=

# --------------------------------------------------------------------
# Vercel Cron. Set to a random string; Vercel sends it as a Bearer token
# to /api/cron/quo-reconcile.
# CRON_SECRET=

# --------------------------------------------------------------------
# Ava's voice on /ava. Without it she still answers, using the visitor's
# browser voice, so this is quality rather than a hard requirement.
#
# Must be a PROJECT variable on redrosetechnologies-site with Production
# ticked. A shared team variable has to be linked to the project as well,
# and a variable added after the last build needs a redeploy before the
# runtime can see it.
# ELEVENLABS_API_KEY=
#
# Optional. Pins which voice she speaks in. Left unset, the account's
# voice list is searched for the one used in the recorded greeting.
# ELEVENLABS_VOICE_ID=
